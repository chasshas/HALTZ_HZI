# Git hash helpers for plain CMake builds (gpu-pico, and the PC).
#
# haltz_git_hash(<out_var>)
#   Sets <out_var> to the first 8 hex characters of the repo's HEAD commit, or "00000000"
#   when git or the repository isn't available. Runs at configure time and asks CMake to
#   re-configure when HEAD moves.
#
# haltz_git_hash_header(<target>)
#   Generates haltz_git_hash.h (#define HALTZ_GIT_HASH "xxxxxxxx") in the build folder and
#   adds it to <target>'s include path.
#
# The PlatformIO projects (cpu-s3, io-esp32) don't use this: PlatformIO doesn't re-run
# CMake when HEAD moves, so they generate the same header with scripts/pio_git_hash.py.
#
# Build tooling only: no board-specific code here.

set(_HALTZ_REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../..")
get_filename_component(_HALTZ_REPO_ROOT "${_HALTZ_REPO_ROOT}" ABSOLUTE)

function(haltz_git_hash out_var)
    set(hash "00000000")
    find_package(Git QUIET)
    if(GIT_FOUND)
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" -C "${_HALTZ_REPO_ROOT}" rev-parse HEAD
            OUTPUT_VARIABLE full
            RESULT_VARIABLE rc
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET)
        if(rc EQUAL 0 AND full MATCHES "^[0-9a-f]+$")
            string(SUBSTRING "${full}" 0 8 hash)
        endif()

        # Re-run configure when the checked-out commit changes.
        set(git_dir "${_HALTZ_REPO_ROOT}/.git")
        if(EXISTS "${git_dir}/HEAD")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${git_dir}/HEAD")
            file(READ "${git_dir}/HEAD" head)
            if(head MATCHES "^ref: ([^\n]+)")
                set(ref_file "${git_dir}/${CMAKE_MATCH_1}")
                if(EXISTS "${ref_file}")
                    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ref_file}")
                endif()
            endif()
        endif()
    endif()
    message(STATUS "HALTZ git hash: ${hash}")
    set(${out_var} "${hash}" PARENT_SCOPE)
endfunction()

function(haltz_git_hash_header target)
    haltz_git_hash(hash)
    set(dir "${CMAKE_CURRENT_BINARY_DIR}/haltz_generated")
    # file(GENERATE) only rewrites the file when its content changes.
    file(GENERATE OUTPUT "${dir}/haltz_git_hash.h" CONTENT
"/* Generated by haltz_git_hash.cmake. Do not edit. */
#ifndef HALTZ_GIT_HASH_H
#define HALTZ_GIT_HASH_H
#define HALTZ_GIT_HASH \"${hash}\"
#endif
")
    target_include_directories(${target} PRIVATE "${dir}")
endfunction()
